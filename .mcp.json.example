{
  "mcpServers": {
    "storagekeys-blog": {
      "command": "node",
      "args": [
        "d:/xampp/htdocs/storage-keys-latest/mcp-blog-server/src/index.js"
      ],
      "env": {
        "BLOG_API_BASE_URL": "https://storagekeys.com/api/mcp",
        "MCP_BLOG_TOKEN": "change-me-to-match-live-MCP_BLOG_TOKEN"
      }
    }
  }
}
